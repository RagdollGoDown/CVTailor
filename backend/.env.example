# Copy to .env and fill in. Never commit .env.

# "dummy" returns canned answers (no network, no cost). "openai_compatible" calls a real LLM API.
LLM_PROVIDER=dummy

# For LLM_PROVIDER=openai_compatible (e.g. Infomaniak AI). The URL is the part before /chat/completions.
# Infomaniak: https://api.infomaniak.com/2/ai/<product_id>/openai/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Send the expected JSON schema as response_format, so the API forces valid output.
LLM_STRUCTURED_OUTPUT=true
LLM_STRICT_SCHEMA=false
# "none" disables thinking (fewer tokens). Leave empty for models that don't support the parameter.
LLM_REASONING_EFFORT=none
LLM_MAX_COMPLETION_TOKENS=4096

# Matches docker-compose.yml (development only). charset=utf8mb4 is required.
DATABASE_URL=mysql+pymysql://cvtailor:cvtailor@localhost:3306/cvtailor?charset=utf8mb4

CORS_ORIGINS=["http://localhost:3000"]
MAX_INPUT_CHARS=20000
